# Schornsteinfeger Ritters – Apache-Konfiguration
# Domain bleibt: https://www.schornsteinfeger.koeln (mit www, wie bisher)

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en/#">
  ErrorDocument 404 /en/404.html
</If>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTPS + www erzwingen (eine einzige 301-Weiterleitung, keine Kette)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.schornsteinfeger.koeln%{REQUEST_URI} [R=301,L,NE]

  # 2) Saubere URLs: /index.html -> /, /impressum.html -> /impressum
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 3) Abschließende Schrägstriche entfernen (/impressum/ -> /impressum)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 4) 301-Weiterleitungen für geänderte/alte URLs
  #    Die bisherige Website hatte laut Sitemap nur /, /impressum und /datenschutz – diese bleiben unverändert.
  #    Weitere alte Adressen (z. B. aus der Google Search Console unter „Seiten“) hier ergänzen:
  RewriteRule ^home/?$ / [R=301,L,NC]
  RewriteRule ^(ueber-uns|uber-uns|about)/?$ /#ueber-uns [R=301,L,NC,NE]
  RewriteRule ^leistungen/?$ /#leistungen [R=301,L,NC,NE]
  # Häufige Schreibweisen/Alt-Adressen auf die Leistungsseiten (Linkpflege)
  RewriteRule ^(schornstein-kehren|kehren)/?$ /leistungen/schornstein-kehren-koeln [R=301,L,NC]
  RewriteRule ^(rauchmelder|rauchwarnmelder)/?$ /leistungen/rauchmelder-wartung-koeln [R=301,L,NC]
  RewriteRule ^(energieberatung|foerdermittel)/?$ /leistungen/energieberatung-koeln [R=301,L,NC]
  RewriteRule ^kontakt/?$ /#kontakt [R=301,L,NC,NE]
  RewriteRule ^galerie/?$ /#ueber-uns [R=301,L,NC,NE]

  # 5) Englische Fassung: gängige Alternativ-URLs auf die echten Seiten
  RewriteRule ^en/(impressum|imprint)/?$ /en/legal-notice [R=301,L,NC]
  RewriteRule ^en/(datenschutz|privacy-policy)/?$ /en/privacy [R=301,L,NC]

  # 6) Erweiterungslose URLs intern auf .html abbilden (/impressum, /en/privacy …)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)$ /$1.html [L]
</IfModule>

# Sicherheits-Header
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
  # CSP: nur eigene Ressourcen. Der Hash erlaubt das einzeilige Inline-Skript im <head> (Klasse "js").
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"

  # Caching: Assets lange, HTML kurz
  <FilesMatch "\.(woff2|svg|jpg|jpeg|png|webp|avif|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>

# Komprimierung
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/xml text/plain application/ld+json
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# Interne Dateien schützen
<FilesMatch "^(\.|README|.*\.md$)">
  Require all denied
</FilesMatch>
